# Forces Next.js build to use webpack instead of Turbopack during `firebase deploy`.
# firebase-tools' Next.js framework adapter always spawns a bare `next build`
# (ignoring package.json's "build" script / --webpack flag), and Next 16 defaults
# to Turbopack. Turbopack's serverExternalPackages handling currently breaks
# `firebase-admin` module resolution in the deployed Cloud Function
# ("Cannot find module 'firebase-admin-<hash>'"), which silently kills all
# Firestore Admin SDK reads/writes in production — the app falls back to the
# bundled data/*.json files and admin panel edits never reach the live site.
# See node_modules/next/dist/lib/bundler.js parseBundlerArgs() for this flag.
IS_WEBPACK_TEST=1
