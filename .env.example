# Canonical public site URL used by metadata and social previews.
NEXT_PUBLIC_SITE_URL=https://thepolibrandagency.web.app

# Firebase web app config for browser-side Auth email-link login.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=thepolibrandagency-d4263.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=thepolibrandagency-d4263
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=thepolibrandagency-d4263.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Admin authentication.
# Production requires ADMIN_PASSWORD plus either AUTH_SECRET or ADMIN_SESSION_SECRET.
ADMIN_EMAIL=admin@polibrand.co
ADMIN_PASSWORD=replace-with-a-long-random-password
AUTH_SECRET=replace-with-a-long-random-session-secret

# Temporary shared client portal access code.
# Firebase Auth ID tokens are supported by /api/portal/login; keep this only as fallback.
CLIENT_PORTAL_ACCESS_CODE=replace-with-client-access-code

# Firebase Admin SDK.
# On Firebase App Hosting / Cloud Functions, application default credentials may work.
# For other environments, provide FIREBASE_SERVICE_ACCOUNT_KEY as the full JSON service account string.
FIREBASE_PROJECT_ID=thepolibrandagency-d4263
FIREBASE_STORAGE_BUCKET=thepolibrandagency-d4263.appspot.com
FIREBASE_SERVICE_ACCOUNT_KEY=
